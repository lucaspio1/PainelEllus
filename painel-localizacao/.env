# Configuração do Painel de Localização de Alunos

# Porta do servidor (padrão: 3000)
PORT=3000

# ========================================
# FIREBASE CONFIGURATION
# ========================================
# Para obter essas credenciais do Firebase:
# 1. Acesse: https://console.firebase.google.com/
# 2. Selecione seu projeto
# 3. Vá em: Configurações do projeto (ícone de engrenagem) > Contas de serviço
# 4. Clique em "Gerar nova chave privada"
# 5. Um arquivo JSON será baixado com todas as informações abaixo

# OPÇÃO 1: Usar variáveis de ambiente (RECOMENDADO para produção/GCP)
# Copie os valores do arquivo JSON baixado:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# OPÇÃO 2: Para deploy no GCP (Cloud Run, App Engine, Compute Engine)
# Descomente a linha abaixo e defina o ID do projeto:
# GCP_PROJECT=your-project-id

# OPÇÃO 3: Para desenvolvimento local (ATIVO)
# Baixe o arquivo serviceAccountKey.json e coloque na raiz do projeto
# O sistema detectará automaticamente

# ========================================
# GOOGLE APPS SCRIPT (Legacy - Opcional)
# ========================================
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxuDjkpJ4QuXC59Dufni92LUVF8mYKQ8Til8tYJPUCkCkoYZex6OLBHc1WIGkc8jK25UQ/exec
GOOGLE_SCRIPT_EMBARQUE_URL=https://script.google.com/macros/s/AKfycbwDrn6hRQqOIFJdqTXz5TjYP3Y577w0TmEPePzGHX25rZWmxzbQgzT3Gmnu373l9D7QOg/exec
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json