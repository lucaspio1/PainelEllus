# Configuração do Painel de Localização de Alunos

# Porta do servidor (padrão: 3000)
PORT=3000

# URL do Google Apps Script (OBRIGATÓRIO)
# Para obter essa URL:
# 1. Abra seu Google Apps Script
# 2. Clique em "Implantar" > "Nova implantação"
# 3. Escolha "Aplicativo da Web"
# 4. Configure "Executar como: Eu"
# 5. Configure "Quem tem acesso: Qualquer pessoa"
# 6. Clique em "Implantar"
# 7. Copie a URL gerada e cole abaixo
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxuDjkpJ4QuXC59Dufni92LUVF8mYKQ8Til8tYJPUCkCkoYZex6OLBHc1WIGkc8jK25UQ/exec
