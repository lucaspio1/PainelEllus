{
  "name": "painel-localizacao-alunos",
  "version": "1.0.0",
  "description": "Painel para visualizar localização dos alunos em viagens",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test-firebase.js",
    "test:firebase": "node test-firebase.js",
    "build": "pkg . --targets node18-win-x64 --output dist/PainelEllus.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      ".env" 
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "keywords": [
    "painel",
    "alunos",
    "localizacao"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}